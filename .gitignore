# Archivos y carpetas generados por Visual Studio y el sistema
.vs/
x64/
*.vcxproj.user
*.vcxproj.filters

# Librerías externas (glfw-3.4.bin.WIN64/, glew-2.1.0/, fftw-3.3.5-dll64/, json-develop/)
# Se versionan dentro del repo a propósito para no tener que descargarlas de nuevo.
# Solo se excluyen los intermedios generados al crear las .lib de FFTW.
fftw-3.3.5-dll64/*.exp

# Generado por Visual Studio al abrir la carpeta (modo "Abrir carpeta"), no por la solución
CppProperties.json
CMakeSettings.json

# Salida de construcción de CMake
build*/
